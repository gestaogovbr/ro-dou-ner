# Docker application only; PostgreSQL/OpenSearch are reused from Ro-DOU.
RO_DOU_NER_SHARED_NETWORK=ro-dou_default
RO_DOU_NER_DATABASE_DSN=postgresql://airflow:YOUR_PASSWORD@ro-dou-postgres-1:5432/inlabs
RO_DOU_NER_INLABS_DSN=postgresql://airflow:YOUR_PASSWORD@ro-dou-postgres-1:5432/inlabs
RO_DOU_NER_OPENSEARCH_URL=http://opensearch:9200
RO_DOU_NER_MODE=rules
