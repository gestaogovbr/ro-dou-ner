# Run on the host using the PostgreSQL/OpenSearch ALREADY running in Ro-DOU.
# Replace YOUR_PASSWORD with the existing credential; never commit an actual .env.
RO_DOU_NER_DATABASE_DSN=postgresql://airflow:YOUR_PASSWORD@127.0.0.1:5432/inlabs
RO_DOU_NER_INLABS_DSN=postgresql://airflow:YOUR_PASSWORD@127.0.0.1:5432/inlabs
RO_DOU_NER_OPENSEARCH_URL=http://127.0.0.1:9200
# A separate test database on that same PostgreSQL instance; never use inlabs for tests.
RO_DOU_NER_TEST_POSTGRES_DSN=postgresql://airflow:YOUR_PASSWORD@127.0.0.1:5432/ro_dou_ner_test
RO_DOU_NER_TEST_OPENSEARCH_URL=http://127.0.0.1:9200
RO_DOU_NER_MODE=rules
# Hybrid requires immutable model and tokenizer/backbone commits; see README.
